{
  "name": "vpn-manager",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --cwd apps/server dev",
    "dev:web": "bun --cwd apps/web dev",
    "build": "bun run build:web",
    "build:web": "bun --cwd apps/web build",
    "start": "bun --cwd apps/server start",
    "test": "bun test apps/server",
    "test:web": "bun --cwd apps/web test"
  },
  "workspaces": ["apps/*"],
  "dependencies": {
    "kill-port": "^2.0.1"
  }
}
