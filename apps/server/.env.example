# Local dev: copy this file to `.env` in this folder (`apps/server`).
# Run the API from repo root with: `bun --cwd apps/server dev`
# Bun loads `.env` from the process cwd (here: `apps/server` when using --cwd).

# --- Server (apps/server/src/index.ts via env.ts) ---

# Required. Base64 of exactly 32 bytes. Below is 32× 0x00 — OK for local dev only; use a random key in production.
VPN_MANAGER_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# When true/1/yes, HTTPS requests from the API to the 3x-ui panel (e.g. Generate profile) skip TLS
# certificate verification. Use only for dev or panels with self-signed / private CA certs.
# VPN_MANAGER_PANEL_TLS_INSECURE=true

# Optional. HTTP port for the API (Vite proxies to this in dev).
PORT=3000

# Optional. SQLite file path (relative paths resolve from cwd, usually `apps/server`).
DATABASE_PATH=data/vpn-manager.sqlite

# Optional. Serve the built SPA from this directory (set after `bun --cwd apps/web build`).
# Example from repo root: STATIC_DIR=../web/dist
# STATIC_DIR=

# When false/unset, POST /api/profiles/:id/setup never opens SSH (dry-run only).
# Same gate applies to the browser SSH terminal (WebSocket /api/profiles/:id/ssh): no outbound SSH until true.
# These three variables seed the initial `app_settings` row in SQLite when the DB has none yet; after that,
# signed-in users can change them under Settings in the web app (SQLite is the source of truth).
VPN_SSH_ENABLED=false

# Optional ACME / Let's Encrypt registrant contact (app settings). Not tied to any specific TLS stack in this repo.
# ACME_EMAIL=ops@example.com

# Live setup and clear-server run remote bash via the `ssh2` package (same dependency as the browser SSH terminal).
# Optional: path to a known_hosts file for stricter host keys (setup + browser terminal share this policy).
# SSH_KNOWN_HOSTS_FILE=/path/to/known_hosts

# Optional. Set to `production` only when testing Secure cookies over HTTPS.
# NODE_ENV=development

# --- create-admin.ts (read when you run `bun scripts/create-admin.ts`; not used by the server) ---

# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-in-copy
